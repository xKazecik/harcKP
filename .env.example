# =============================================================================
# HARC — konfiguracja środowiskowa
# Zmienna środowiskowa jest NADRZĘDNA wobec ustawień w bazie (§5).
# Pole nadpisane przez env jest w panelu wyszarzone (SETTING_LOCKED_BY_ENV).
# =============================================================================

# --- Aplikacja ---------------------------------------------------------------
# Publiczny adres aplikacji webowej (bez końcowego /)
APP_URL=http://localhost:3000
# Nazwa instancji wyświetlana w UI i e-mailach
APP_NAME=HARC
# Motyw domyślny dla niezalogowanych i nowych kont: light | dark | system
DEFAULT_THEME=system
# Początek roku harcerskiego (MM-DD) — plany pracy, kategoryzacja
SCOUTING_YEAR_START=09-01

# --- Baza danych i Redis -----------------------------------------------------
# Połączenie PostgreSQL (Prisma)
DATABASE_URL=postgresql://harc:harc@localhost:5432/harc
# Połączenie Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# --- Keycloak ----------------------------------------------------------------
# Issuer realmu (…/realms/{realm})
KEYCLOAK_ISSUER_URL=http://localhost:8080/realms/harc
# Nazwa realmu
KEYCLOAK_REALM=harc
# Klient aplikacji webowej (confidential, PKCE S256)
KEYCLOAK_WEB_CLIENT_ID=harc-web
# Sekret klienta webowego — dev: wartość z realm-export.json; prod: wygeneruj nowy
KEYCLOAK_WEB_CLIENT_SECRET=dev-only-change-me-web
# Audience weryfikowany przez API
KEYCLOAK_API_AUDIENCE=harc-api
# Klient techniczny Admin API (service account, tylko role z §9.2)
KEYCLOAK_ADMIN_CLIENT_ID=harc-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=dev-only-change-me-admin
# Grupa Keycloak dająca uprawnienie ROOT (pełna ścieżka, z ukośnikiem)
KEYCLOAK_ROOT_GROUP=/zhr_sysadmins
# Rejestracja własna — ZAWSZE false; konto zakłada komendant (§8.1)
ALLOW_REGISTRATION=false
# Bootstrap pustej instalacji: lista UUID (sub) rozdzielona przecinkami.
# Działa TYLKO dopóki nie istnieje żaden SYSADMIN (§9.4).
ROOT_BOOTSTRAP_SUBS=
# Dane profilu zakładanego dla kont z ROOT_BOOTSTRAP_SUBS przy starcie (usługa init)
ROOT_BOOTSTRAP_FIRST_NAME=Administrator
ROOT_BOOTSTRAP_LAST_NAME=Systemu
ROOT_BOOTSTRAP_EMAIL=
# Przykładowa struktura demonstracyjna ładowana przy starcie (jednostki, osoby,
# rozkaz, plan pracy). Ustaw false na instalacji produkcyjnej.
SEED_DEMO=false

# --- Zaproszenia i konta -----------------------------------------------------
# Ważność linku zaproszenia (godziny)
INVITATION_TTL_HOURS=168
# Minimalny odstęp między ponownymi wysyłkami zaproszenia (minuty)
INVITATION_RESEND_COOLDOWN_MINUTES=15
# Domena tombstone dla adresów zwalnianych przy archiwizacji (§8.3)
ACCOUNT_ARCHIVE_TOMBSTONE_DOMAIN=archived.harc.invalid

# --- Mapa publiczna ----------------------------------------------------------
# Włącza publiczną mapę jednostek
PUBLIC_MAP_ENABLED=true
# Ścieżka mapy publicznej
PUBLIC_MAP_URL=/mapa-jednostek
# Moderacja wizytówek przez jednostkę nadrzędną (domyślnie wyłączona, §15)
REQUIRE_UNIT_CARD_APPROVAL=false

# --- Google ------------------------------------------------------------------
# Tryb integracji: WORKSPACE_SERVICE_ACCOUNT | OAUTH_PERSONAL | DISABLED
GOOGLE_MODE=DISABLED
# JSON konta serwisowego (tryb WORKSPACE_SERVICE_ACCOUNT) — cała zawartość pliku
GOOGLE_SERVICE_ACCOUNT_JSON=
# Konto podszywane przy domain-wide delegation
GOOGLE_IMPERSONATE_SUBJECT=

# --- Pliki (S3 / MinIO) ------------------------------------------------------
# Endpoint S3 (dev: MinIO)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=harc
S3_ACCESS_KEY=harc
S3_SECRET_KEY=harc-dev-secret
# Ważność linków do eksportów (minuty)
EXPORT_LINK_TTL_MINUTES=30

# --- SMTP (aplikacja) --------------------------------------------------------
# Dev: MailHog. Keycloak ma własną konfigurację SMTP w realmie (§9.1).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=harc@example.org

# --- Dane --------------------------------------------------------------------
# Retencja danych (miesiące) — job czyszczący wg rejestru czynności (§17)
DATA_RETENTION_MONTHS=120
# Klucz AES-GCM (32 bajty, base64) do szyfrowania tokenów Google w bazie (§14.2)
ENCRYPTION_KEY=
